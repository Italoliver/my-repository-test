// 1. Variáveis e Constantes 📦
const nomeUsuario = "Ítalo";
let saldoDesenvolvedor = 1000; // O saldo vai crescer! 📈

// 2. Uma função simples de saudação 🤝
function boasVindas(nome) {
    return `Olá, ${nome}! Bem-vindo ao mundo da programação. 🚀`;
}

// 3. Estrutura condicional (Tomada de decisão) 🚦
const nivelAcesso = "admin";

if (nivelAcesso === "admin") {
    console.log(boasVindas(nomeUsuario));
    console.log("Acesso total liberado! ✅");
} else {
    console.log("Acesso restrito. 🔒");
}

// 4. Trabalhando com Arrays (Listas) 📋
const tecnologias = ["HTML", "CSS", "JavaScript", "React"];

console.log("\nMinha stack de estudos:");
tecnologias.forEach((tech, index) => {
    console.log(`${index + 1}. ${tech} ✨`);
});

// 5. Um pequeno loop para contagem regressiva ⏳
console.log("\nIniciando sistema em...");
for (let i = 3; i > 0; i--) {
    console.log(`${i}... 🕒`);
}
console.log("DECOLAR! 🚀🔥");

